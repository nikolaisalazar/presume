{
  "name": "presume",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/create-spa-fallback.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:backend": "python3 -m pytest review-service/tests -q",
    "verify": "npm run typecheck && npm test -- --run && npm run test:backend",
    "verify:full": "npm run verify && npm run test:e2e",
    "test:e2e": "npm run test:e2e:unconfigured && npm run test:e2e:configured",
    "test:e2e:unconfigured": "npm run build && playwright test -c playwright.unconfigured.config.ts",
    "test:e2e:configured": "VITE_REVIEW_API_URL=http://127.0.0.1:8124 npm run build && playwright test -c playwright.configured.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@chenglou/pretext": "^0.0.5",
    "@react-pdf/renderer": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "pdfjs-dist": "^5.4.149",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.7.2",
    "vite": "^6.3.1",
    "vitest": "^3.1.2"
  }
}
