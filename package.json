{
  "name": "presume",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/create-spa-fallback.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "npm run test:e2e:unconfigured && npm run test:e2e:configured",
    "test:e2e:unconfigured": "npm run build && playwright test -c playwright.unconfigured.config.ts",
    "test:e2e:configured": "VITE_REVIEW_API_URL=http://127.0.0.1:8124 npm run build && playwright test -c playwright.configured.config.ts"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "typescript": "~5.7.2",
    "vite": "^6.3.1",
    "vitest": "^3.1.2"
  }
}
